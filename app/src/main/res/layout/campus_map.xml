<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:padding="16dp">

        <TextView
            android:id="@+id/buildingName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold" />

        <com.example.dbtest.map.SiteMapView
            android:id="@+id/siteMapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/buildingName"
            android:layout_above="@id/floatingActionButton"
            android:layout_marginTop="29dp"
            android:contentDescription="@string/app_name" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/floorToggleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="24dp"
            android:text="Floor 1"
            android:contentDescription="Toggle floor" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/floatingActionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:contentDescription="Settings"
            android:focusable="true"
            android:src="@drawable/settings_logo"
            android:tint="@color/purple_500"
            android:tintMode="add" />

    </RelativeLayout>

    <include
        android:id="@+id/slider_root"
        layout="@layout/slider" />

</FrameLayout>